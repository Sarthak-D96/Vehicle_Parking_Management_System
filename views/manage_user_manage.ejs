
<!-- This is the manage user page for the Smart Parking System. 
It displays a list of vehicles registered to a specific user, along with their parking status and location if parked. 
The page includes a header with the user's name and a back button to return to the user list. The main content is a table that lists each vehicle's model, whether it is currently parked, and if so, the lot and space information. If the user has no registered vehicles, a message is displayed instead. 
The design is simple and clean, using basic HTML and CSS for styling. -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>User Vehicles</title>
  <link rel="stylesheet" href="/main/style.css" />
</head>
<body>
  <header>
    <h1>🚗 Vehicles of <%= user.name %></h1>
    <form action="/manage_user" method="get">
      <button type="submit">⬅ Back to User List</button>
    </form>
  </header>

  <main>
    <% if (vehicles.length === 0) { %>
      <p>This user has no registered vehicles.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Vehicle Model</th>
            <th>Parked?</th>
            <th>Lot</th>
            <th>Space</th>
          </tr>
        </thead>
        <tbody>
          <% vehicles.forEach(vehicle => { %>
            <tr>
              <td><%= vehicle.model %></td>
              <td><%= vehicle.is_parked ? "Yes" : "No" %></td>
              <td><%= vehicle.is_parked ? vehicle.lot : "—" %></td>
              <td><%= vehicle.is_parked ? vehicle.space_id : "—" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table> 
    <% } %>
  </main>
</body>
</html>
